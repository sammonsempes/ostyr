[Unit]
Description=RustDesk hbbr (relay, headless, key required)
Wants=network-online.target
After=network-online.target rustdesk-hbbs.service

[Service]
User=rustdesk
Group=rustdesk
StateDirectory=rustdesk
StateDirectoryMode=0700
WorkingDirectory=/var/lib/rustdesk
UMask=0077
ExecStart=/usr/local/sbin/ostyr-rustdesk-start hbbr
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
