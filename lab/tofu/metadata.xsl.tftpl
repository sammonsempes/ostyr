<?xml version="1.0"?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
  <xsl:output method="xml" indent="yes"/>
  <xsl:template match="@*|node()">
    <xsl:copy>
      <xsl:apply-templates select="@*|node()"/>
    </xsl:copy>
  </xsl:template>
  <xsl:template match="/domain/devices/disk[@device='disk']/driver/@type">
    <xsl:attribute name="type">qcow2</xsl:attribute>
  </xsl:template>
%{ if tcg ~}
  <xsl:template match="/domain/cpu">
    <cpu mode="custom" match="exact" check="none">
      <model fallback="forbid">Haswell-noTSX</model>
    </cpu>
  </xsl:template>
%{ endif ~}
%{ if secure_boot ~}
  <xsl:template match="/domain/devices/disk[@device='cdrom']/target">
    <target dev="sda" bus="sata"/>
  </xsl:template>
  <xsl:template match="/domain/devices/video/model/@type">
    <xsl:attribute name="type">vga</xsl:attribute>
  </xsl:template>
  <xsl:template match="/domain/os/loader">
    <xsl:copy>
      <xsl:attribute name="secure">yes</xsl:attribute>
      <xsl:apply-templates select="@*|node()"/>
    </xsl:copy>
  </xsl:template>
  <xsl:template match="/domain/features">
    <xsl:copy>
      <xsl:apply-templates select="@*|node()"/>
      <smm state="on"/>
    </xsl:copy>
  </xsl:template>
%{ endif ~}
  <xsl:template match="/domain">
    <xsl:copy>
      <xsl:apply-templates select="@*|node()"/>
      <metadata>
        <ostyr:lab xmlns:ostyr="urn:ostyr:lab">
          <ostyr:task>${task_id}</ostyr:task>
          <ostyr:created>${created_at}</ostyr:created>
        </ostyr:lab>
      </metadata>
    </xsl:copy>
  </xsl:template>
</xsl:stylesheet>
