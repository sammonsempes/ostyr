#!/usr/bin/env bash
set -euo pipefail
if ! command -v cargo >/dev/null 2>&1; then export PATH="$HOME/.cargo/bin:$PATH"; fi
ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"
export CARGO_INCREMENTAL=0
if command -v sccache >/dev/null 2>&1; then
  export RUSTC_WRAPPER=sccache
  export SCCACHE_DIR="${SCCACHE_DIR:-$HOME/.cache/sccache}"
  export SCCACHE_CACHE_SIZE="${SCCACHE_CACHE_SIZE:-20G}"
fi
GATE_LOCK_WAIT_SECONDS=3600
DEFAULT_BUILD_JOBS=8
export CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-$DEFAULT_BUILD_JOBS}"
MAIN_TARGET="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")/target"
if [ -n "${OSTYR_PRIVATE_TARGET:-}" ]; then unset CARGO_TARGET_DIR; fi
if [ -z "${OSTYR_PRIVATE_TARGET:-}" ]; then
  if [ -z "${CARGO_TARGET_DIR:-}" ]; then
    export CARGO_TARGET_DIR="$MAIN_TARGET"
  else
    WANTED=$(realpath -m "$CARGO_TARGET_DIR")
    if [ "$WANTED" != "$(realpath -m "$MAIN_TARGET")" ] && [ "$WANTED" != "$(realpath -m "$ROOT/target")" ]; then
      echo "pre-commit: CARGO_TARGET_DIR=$CARGO_TARGET_DIR is neither $MAIN_TARGET nor $ROOT/target" >&2
      exit 1
    fi
  fi
fi
TARGET="${CARGO_TARGET_DIR:-target}"

LOW=()
if command -v nice >/dev/null 2>&1; then
  LOW=(nice -n 10)
  if command -v ionice >/dev/null 2>&1; then LOW+=(ionice -c 3); fi
fi

low() {
  "${LOW[@]+"${LOW[@]}"}" "$@"
}

step() {
  local name=$1
  shift
  echo "pre-commit: $name" >&2
  if ! "$@" 9>&-; then
    echo "pre-commit: FAILED at step: $name" >&2
    exit 1
  fi
}

lint() {
  if [ -n "${CUSTOM_LINT:-}" ]; then "$CUSTOM_LINT" "$ROOT"; else low cargo run --offline -q -p custom_lint -- "$ROOT"; fi
}

gate() {
  if [ -n "${COVERAGE_GATE:-}" ]; then "$COVERAGE_GATE" "$EXPORT" "$ROOT"; else low cargo run --offline -q -p coverage_gate -- "$EXPORT" "$ROOT"; fi
}

covered_tests() {
  local scratch="$GATE_DIR/tmp-$$"
  mkdir -p "$scratch"
  local status=0
  TMPDIR="$scratch" low cargo +nightly llvm-cov --offline --branch --fail-under-lines 100 --json --output-path "$EXPORT" || status=$?
  rm -rf "$scratch"
  return "$status"
}

prepare_gate_dir() {
  if [ -n "${CARGO_TARGET_DIR:-}" ]; then
    GATE_DIR="$TARGET/gates/$(printf %s "$ROOT" | cksum | cut -d' ' -f1)"
    export CARGO_LLVM_COV_TARGET_DIR="$GATE_DIR/llvm-cov-target"
    export CARGO_LLVM_COV_BUILD_DIR="$TARGET/llvm-cov-target"
    GATE_STALE_DAYS=1
    if [ -d "$TARGET/gates" ]; then find "$TARGET/gates" -mindepth 1 -maxdepth 1 -mtime "+$GATE_STALE_DAYS" -exec rm -rf {} +; fi
    trap 'rm -rf "$GATE_DIR"' EXIT
  else
    GATE_DIR="$TARGET"
  fi
  EXPORT="${COVERAGE_EXPORT:-$GATE_DIR/coverage.json}"
  mkdir -p "$(dirname "$EXPORT")"
}

take_gate_lock() {
  local wait_seconds="${OSTYR_GATE_LOCK_WAIT_SECONDS:-$GATE_LOCK_WAIT_SECONDS}"
  mkdir -p "$MAIN_TARGET"
  exec 9>"$MAIN_TARGET/.gate.lock"
  if ! flock -n 9; then
    echo "pre-commit: waiting for the gate lock $MAIN_TARGET/.gate.lock" >&2
    if ! flock -w "$wait_seconds" 9; then
      echo "pre-commit: timed out after ${wait_seconds}s on the gate lock $MAIN_TARGET/.gate.lock" >&2
      exit 1
    fi
  fi
}

docs_only() {
  local staged path
  staged=$(git diff --cached --name-only --diff-filter=ACMRD)
  [ -n "$staged" ] || return 1
  while IFS= read -r path; do
    case "$path" in
      backlog/* | .cache/*) ;;
      crates/* | tools/* | lab/* | docs/*) return 1 ;;
      *.md) ;;
      *) return 1 ;;
    esac
  done <<<"$staged"
}

if docs_only; then
  step "custom_lint" lint
  echo "pre-commit: documentation-only commit, Rust steps skipped" >&2
  exit 0
fi

prototype_branch() {
  local branch
  branch=$(git symbolic-ref --short HEAD 2>/dev/null) || return 1
  case "$branch" in
    prototype/?*) return 0 ;;
    *) return 1 ;;
  esac
}

if prototype_branch; then
  take_gate_lock
  step "1/4 cargo +nightly fmt --check" low cargo +nightly fmt --check
  step "2/4 cargo clippy" low cargo clippy --offline --all-targets -- -D warnings
  step "3/4 custom_lint" lint
  step "4/4 cargo test" low cargo test --offline --workspace
  echo "pre-commit: LIGHT GATE (prototype branch): coverage not checked" >&2
  exit 0
fi

take_gate_lock
prepare_gate_dir
step "1/5 cargo +nightly fmt --check" low cargo +nightly fmt --check
step "2/5 cargo clippy" low cargo clippy --offline --all-targets -- -D warnings
step "3/5 custom_lint" lint
step "4/5 cargo llvm-cov" covered_tests
step "5/5 coverage_gate" gate
echo "pre-commit: all steps passed" >&2
