#!/usr/bin/env bash
set -euo pipefail
if ! command -v cargo >/dev/null 2>&1; then export PATH="$HOME/.cargo/bin:$PATH"; fi
ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"
export CARGO_INCREMENTAL=0
EXPORT="${COVERAGE_EXPORT:-target/coverage.json}"
mkdir -p "$(dirname "$EXPORT")"

step() {
  local name=$1
  shift
  echo "pre-commit: $name" >&2
  if ! "$@"; then
    echo "pre-commit: FAILED at step: $name" >&2
    exit 1
  fi
}

lint() {
  if [ -n "${CUSTOM_LINT:-}" ]; then "$CUSTOM_LINT" "$ROOT"; else cargo run --offline -q -p custom_lint -- "$ROOT"; fi
}

gate() {
  if [ -n "${COVERAGE_GATE:-}" ]; then "$COVERAGE_GATE" "$EXPORT" "$ROOT"; else cargo run --offline -q -p coverage_gate -- "$EXPORT" "$ROOT"; fi
}

covered_tests() {
  local scratch="/dev/shm/ostyr-gate-$$"
  mkdir -p "$scratch"
  local status=0
  TMPDIR="$scratch" cargo +nightly llvm-cov --offline --branch --fail-under-lines 100 --json --output-path "$EXPORT" || status=$?
  rm -rf "$scratch"
  return "$status"
}

step "1/5 cargo +nightly fmt --check" cargo +nightly fmt --check
step "2/5 cargo clippy" cargo clippy --offline --all-targets -- -D warnings
step "3/5 custom_lint" lint
step "4/5 cargo llvm-cov" covered_tests
step "5/5 coverage_gate" gate
echo "pre-commit: all steps passed" >&2
