#!/usr/bin/env bash
set -euo pipefail
if ! command -v cargo >/dev/null 2>&1; then export PATH="$HOME/.cargo/bin:$PATH"; fi
ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"
export CARGO_INCREMENTAL=0
if command -v sccache >/dev/null 2>&1; then
  export RUSTC_WRAPPER=sccache
  export SCCACHE_DIR="${SCCACHE_DIR:-$HOME/.cache/sccache}"
  export SCCACHE_CACHE_SIZE="${SCCACHE_CACHE_SIZE:-20G}"
  export SCCACHE_SERVER_UDS="${SCCACHE_SERVER_UDS:-/tmp/sccache-$(id -u).sock}"
fi
OWN_TARGET="$ROOT/target"
if [ -n "${CARGO_TARGET_DIR:-}" ] && [ "$(realpath -m "$CARGO_TARGET_DIR")" != "$(realpath -m "$OWN_TARGET")" ]; then
  echo "pre-commit: CARGO_TARGET_DIR=$CARGO_TARGET_DIR is not $OWN_TARGET" >&2
  exit 1
fi
export CARGO_TARGET_DIR="$OWN_TARGET"
TARGET="$CARGO_TARGET_DIR"

WRAP=()
if [ "$(id -u)" = 0 ] && command -v setpriv >/dev/null 2>&1; then
  WRAP=(setpriv --bounding-set "-dac_override,-dac_read_search,-fowner")
fi

low() {
  "${WRAP[@]+"${WRAP[@]}"}" "$@"
}

step() {
  local name=$1
  shift
  echo "pre-commit: $name" >&2
  if ! "$@"; then
    echo "pre-commit: FAILED at step: $name" >&2
    exit 1
  fi
}

lint() {
  if [ -n "${CUSTOM_LINT:-}" ]; then "$CUSTOM_LINT" "$ROOT"; else low cargo run --offline -q -p custom_lint -- "$ROOT"; fi
}

gate() {
  local -a dirs=("${SCOPE_DIRS[@]+"${SCOPE_DIRS[@]}"}")
  if [ -n "${COVERAGE_GATE:-}" ]; then "$COVERAGE_GATE" "$EXPORT" "$ROOT" "${dirs[@]+"${dirs[@]}"}"
  else low cargo run --offline -q -p coverage_gate -- "$EXPORT" "$ROOT" "${dirs[@]+"${dirs[@]}"}"; fi
}

GATE_TMPFS="${GATE_TMPFS:-/run/ostyr-gate}"
GATE_TMPFS_FLOOR_KB="${GATE_TMPFS_FLOOR_KB:-4194304}"

tmpfs_has_room() {
  local free_kb
  [ -d "$GATE_TMPFS" ] && [ -w "$GATE_TMPFS" ] || return 1
  free_kb=$(df -Pk "$GATE_TMPFS" 2>/dev/null | awk 'NR == 2 { print $4 }')
  [ -n "$free_kb" ] && [ "$free_kb" -ge "$GATE_TMPFS_FLOOR_KB" ]
}

pick_scratch() {
  TMPFS_RUN=""
  if tmpfs_has_room; then
    TMPFS_RUN="$GATE_TMPFS/run-$$"
    mkdir -p -m 0755 "$TMPFS_RUN" || TMPFS_RUN=""
  fi
  if [ -n "$TMPFS_RUN" ]; then SCRATCH="$TMPFS_RUN"; else SCRATCH="$RUN_DIR/tmp"; fi
  mkdir -p "$SCRATCH"
}

covered_tests() {
  local status=0
  pick_scratch
  TMPDIR="$SCRATCH" low cargo +nightly llvm-cov --offline --branch "${PACKAGE_ARGS[@]+"${PACKAGE_ARGS[@]}"}" --fail-under-lines 100 --json --output-path "$EXPORT" || status=$?
  rm -rf "$SCRATCH"
  return "$status"
}

doc_tests() {
  local status=0
  pick_scratch
  TMPDIR="$SCRATCH" low cargo test --doc --offline "${PACKAGE_ARGS[@]+"${PACKAGE_ARGS[@]}"}" || status=$?
  rm -rf "$SCRATCH"
  return "$status"
}

cleanup_run() {
  rm -rf "$RUN_DIR"
  if [ -n "${TMPFS_RUN:-}" ]; then rm -rf "$TMPFS_RUN"; fi
  if [ -z "$(find "$GATE_DIR" -mindepth 1 -maxdepth 1 -name 'run-*' 2>/dev/null)" ]; then rm -rf "$GATE_DIR"; fi
}

prepare_gate_dir() {
  GATE_DIR="$TARGET/gates/$(printf %s "$ROOT" | cksum | cut -d' ' -f1)"
  RUN_DIR="$GATE_DIR/run-$$"
  export CARGO_LLVM_COV_TARGET_DIR="$GATE_DIR/llvm-cov-target"
  export CARGO_LLVM_COV_BUILD_DIR="$TARGET/llvm-cov-target"
  GATE_STALE_DAYS=1
  if [ -d "$TARGET/gates" ]; then find "$TARGET/gates" -mindepth 1 -maxdepth 1 -mtime "+$GATE_STALE_DAYS" -exec rm -rf {} +; fi
  if [ -d "$GATE_TMPFS" ]; then find "$GATE_TMPFS" -mindepth 1 -maxdepth 1 -name 'run-*' -mtime "+$GATE_STALE_DAYS" -exec rm -rf {} + 2>/dev/null || true; fi
  trap cleanup_run EXIT
  EXPORT="${COVERAGE_EXPORT:-$RUN_DIR/coverage.json}"
  mkdir -p "$RUN_DIR" "$(dirname "$EXPORT")"
}

MENTION_PATTERN='cl''aude|anthro''pic'

unpublished_path() {
  case "$1" in
    .cl''aude/* | backlog/* | docs/ai-development.md | .githooks/commit-msg | tests/cl''aude-hooks.sh | CL''AUDE.md | */CL''AUDE.md) return 0 ;;
    *) return 1 ;;
  esac
}

rewritten_path() {
  local filter="$ROOT/.cl""aude/publish/index-filter.sh"
  [ -f "$filter" ] && grep -q -F -- "rewrite $1 " "$filter"
}

check_published_mentions() {
  local path added found=0
  local -a paths
  mapfile -t paths < <(git diff --cached --name-only --diff-filter=ACMR)
  for path in "${paths[@]+"${paths[@]}"}"; do
    if ! unpublished_path "$path" && ! rewritten_path "$path"; then
      added=$(git diff --cached -U0 -- "$path" | grep '^+' | grep -v '^+++ ' || true)
      if grep -q -i -E -- "$MENTION_PATTERN" <<<"$added"; then
        echo "pre-commit: $path is published and an added line matches '$MENTION_PATTERN'; reword it or add a rewrite in its index-filter.sh" >&2
        found=1
      fi
    fi
  done
  return "$found"
}

if ! check_published_mentions; then exit 1; fi

docs_only() {
  local staged path
  staged=$(git diff --cached --name-only --diff-filter=ACMRD)
  [ -n "$staged" ] || return 1
  while IFS= read -r path; do
    case "$path" in
      backlog/* | .cache/* | NOTES.md | */NOTES.md) ;;
      crates/* | tools/* | lab/* | docs/*) return 1 ;;
      *.md) ;;
      *) return 1 ;;
    esac
  done <<<"$staged"
}

if docs_only; then
  step "custom_lint" lint
  echo "pre-commit: documentation-only commit, Rust steps skipped" >&2
  exit 0
fi

SCOPE_JQ='
  . as $meta
  | ($meta.workspace_members) as $members
  | [$meta.packages[] | select(.id as $id | $members | index($id)) | {id, name, dir: (.manifest_path | ltrimstr($root + "/") | rtrimstr("/Cargo.toml"))}] as $pkgs
  | [$staged[] | . as $path | {path: $path, hit: ($pkgs | map(select(.dir as $dir | $path | startswith($dir + "/"))) | first)}] as $hits
  | ($hits | map(select(.hit == null)) | first) as $outside
  | if $outside != null then "FULL " + $outside.path + " is outside every package"
    else
      ($hits | map(.hit.id) | unique) as $seed
      | def grow($set): ([$meta.resolve.nodes[] | select(any(.deps[]; .pkg as $dep | $set | index($dep))) | .id | select(. as $id | $members | index($id))] + $set | unique);
        ($seed | until(. as $set | grow($set) == $set; grow(.))) as $closed
      | $pkgs[] | select(.id as $id | $closed | index($id)) | "PKG " + .name + " " + .dir
    end'

forced_full_path() {
  case "$1" in
    Cargo.toml | */Cargo.toml | Cargo.lock | rust-toolchain.toml | rustfmt.toml | clippy.toml | .githooks/* | tools/custom_lint/* | tools/coverage_gate/*) return 0 ;;
    */CL''AUDE.md | *.rs) return 1 ;;
    crates/* | tools/*) return 0 ;;
    *) return 1 ;;
  esac
}

compute_scope() {
  SCOPE_PKGS=()
  SCOPE_DIRS=()
  SCOPE_REASON=""
  local staged path line metadata
  staged=$(git diff --cached --name-only --no-renames --diff-filter=ACMRD)
  if [ "${GATE_SCOPE:-}" = full ]; then
    SCOPE_REASON="GATE_SCOPE=full"
  elif [ -z "$staged" ]; then
    SCOPE_REASON="no staged path"
  else
    while IFS= read -r path; do
      if [ -z "$SCOPE_REASON" ] && forced_full_path "$path"; then SCOPE_REASON="$path changes the whole workspace"; fi
    done <<<"$staged"
  fi
  if [ -z "$SCOPE_REASON" ]; then
    metadata=$(low cargo metadata --offline --format-version 1 2>/dev/null || true)
    if [ -z "$metadata" ]; then
      SCOPE_REASON="no cargo metadata"
    else
      while IFS= read -r line; do
        case "$line" in
          "FULL "*) SCOPE_REASON="${line#FULL }" ;;
          "PKG "*)
            SCOPE_PKGS+=("$(cut -d' ' -f2 <<<"$line")")
            SCOPE_DIRS+=("$(cut -d' ' -f3 <<<"$line")")
            ;;
        esac
      done < <(jq -r --arg root "$ROOT" --argjson staged "$(jq -R . <<<"$staged" | jq -s .)" "$SCOPE_JQ" <<<"$metadata")
      if [ -z "$SCOPE_REASON" ] && [ "${#SCOPE_PKGS[@]}" -eq 0 ]; then SCOPE_REASON="no package resolved"; fi
    fi
  fi
  if [ -n "$SCOPE_REASON" ]; then
    SCOPE_PKGS=()
    SCOPE_DIRS=()
    echo "pre-commit: scope full workspace ($SCOPE_REASON)" >&2
  else
    echo "pre-commit: scope ${#SCOPE_PKGS[@]} packages: ${SCOPE_PKGS[*]}" >&2
  fi
}

package_args() {
  local name
  PACKAGE_ARGS=()
  for name in "${SCOPE_PKGS[@]+"${SCOPE_PKGS[@]}"}"; do PACKAGE_ARGS+=(-p "$name"); done
}

EBPF_NIGHTLY="${EBPF_NIGHTLY:-nightly-2026-11-08}"
EBPF_MANIFEST=crates/ebpf-probes/ebpf/Cargo.toml

kernel_touched() {
  local path
  local -a staged
  if [ "${GATE_SCOPE:-}" = full ]; then return 0; fi
  mapfile -d '' staged < <(git diff --cached --name-only -z --no-renames --diff-filter=ACMRD)
  for path in "${staged[@]+"${staged[@]}"}"; do
    if forced_full_path "$path"; then return 0; fi
    case "$path" in
      crates/ebpf-probes/ebpf/*) return 0 ;;
    esac
  done
  return 1
}

kernel_checks() {
  low cargo +nightly fmt --check --manifest-path "$EBPF_MANIFEST" &&
    low cargo "+$EBPF_NIGHTLY" clippy --offline --locked --release --target bpfel-unknown-none -Z build-std=core \
      --manifest-path "$EBPF_MANIFEST" -- -D warnings
}

compute_scope
prepare_gate_dir
package_args
step "1/6 cargo +nightly fmt --check" low cargo +nightly fmt --check "${PACKAGE_ARGS[@]+"${PACKAGE_ARGS[@]}"}"
step "2/6 cargo clippy" low cargo clippy --offline "${PACKAGE_ARGS[@]+"${PACKAGE_ARGS[@]}"}" --all-targets -- -D warnings
step "3/6 custom_lint" lint
step "4/6 cargo llvm-cov" covered_tests
step "5/6 coverage_gate" gate
step "6/6 cargo test --doc" doc_tests
if kernel_touched; then step "kernel crate: fmt and clippy for bpfel-unknown-none" kernel_checks; fi
echo "pre-commit: all steps passed" >&2
