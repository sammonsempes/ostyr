#!/usr/bin/env bash
set -euo pipefail
if ! command -v cargo >/dev/null 2>&1; then export PATH="$HOME/.cargo/bin:$PATH"; fi
ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"
MAX_CARGO_DEPTH=64

check_cargo_directories() {
  local main_checkout cargo_dir
  if [ -e "$ROOT/.cargo" ] || [ -L "$ROOT/.cargo" ]; then
    echo "pre-commit: $ROOT/.cargo exists: a cargo config in the repository can run a runner or swap a source (refused before any cargo command)" >&2
    return 1
  fi
  main_checkout=$(dirname "$(realpath "$(git rev-parse --git-common-dir)")")
  case "$ROOT/" in
    "$main_checkout"/*) ;;
    *)
      echo "pre-commit: $ROOT is outside the main checkout $main_checkout: the .cargo directories above it cannot be checked (refused)" >&2
      return 1
      ;;
  esac
  cargo_dir=$(dirname "$ROOT")
  for _ in $(seq "$MAX_CARGO_DEPTH"); do
    case "$cargo_dir/" in
      "$main_checkout"/*)
        if [ -e "$cargo_dir/.cargo" ] || [ -L "$cargo_dir/.cargo" ]; then
          echo "pre-commit: $cargo_dir/.cargo exists above the checkout: cargo reads it (refused before any cargo command)" >&2
          return 1
        fi
        cargo_dir=$(dirname "$cargo_dir")
        ;;
    esac
  done
}

if ! check_cargo_directories; then exit 1; fi

GATE_BASE_SHA=""
GATE_BASE_PATTERN='^[A-Za-z0-9._/^~-]+$'
GATE_BASE_MAX=200

refuse() {
  echo "pre-commit: $*" >&2
  return 1
}

resolve_gate_base() {
  local base=${GATE_SCOPE#diff:}
  if [ "${#base}" -gt "$GATE_BASE_MAX" ] || [[ ! "$base" =~ $GATE_BASE_PATTERN ]] || [[ "$base" == -* ]]; then
    refuse "GATE_SCOPE=diff:<base> needs 1 to $GATE_BASE_MAX characters of [A-Za-z0-9._/^~-] and no leading '-' (refused)"
  else
    GATE_BASE_SHA=$(git rev-parse --verify --quiet --end-of-options "$base^{commit}") ||
      refuse "GATE_SCOPE=diff:$base does not resolve to a commit (refused)"
  fi
}

check_gate_base() {
  resolve_gate_base &&
    { git merge-base --is-ancestor "$GATE_BASE_SHA" HEAD || refuse "GATE_SCOPE base $GATE_BASE_SHA is not an ancestor of HEAD (refused)"; } &&
    { git diff --quiet --ignore-submodules=none || refuse "GATE_SCOPE=diff: the working tree differs from HEAD (refused)"; } &&
    { git diff --cached --quiet --ignore-submodules=none || refuse "GATE_SCOPE=diff: the index differs from HEAD (refused)"; } &&
    { [ -z "$(git ls-files --others --exclude-standard -- crates tools)" ] || refuse "GATE_SCOPE=diff: untracked files under crates or tools (refused)"; } &&
    { ! git diff --quiet --ignore-submodules=none "$GATE_BASE_SHA" HEAD || refuse "GATE_SCOPE=diff: $GATE_BASE_SHA and HEAD have the same tree, nothing to gate (refused)"; }
}

check_gate_scope() {
  case "${GATE_SCOPE:-}" in
    "" | full) ;;
    diff:*) check_gate_base ;;
    *) refuse "GATE_SCOPE must be full, diff:<base> or unset (refused)" ;;
  esac
}

if ! check_gate_scope; then exit 1; fi

changed() {
  if [ -n "$GATE_BASE_SHA" ]; then git diff --ignore-submodules=none "$@" "$GATE_BASE_SHA" HEAD; else git diff --cached --ignore-submodules=none "$@"; fi
}
export CARGO_INCREMENTAL=0
if command -v sccache >/dev/null 2>&1; then
  export RUSTC_WRAPPER=sccache
  export SCCACHE_DIR="${SCCACHE_DIR:-$HOME/.cache/sccache}"
  export SCCACHE_CACHE_SIZE="${SCCACHE_CACHE_SIZE:-20G}"
  export SCCACHE_SERVER_UDS="${SCCACHE_SERVER_UDS:-/tmp/sccache-$(id -u).sock}"
fi
OWN_TARGET="$ROOT/target"
if [ -n "${CARGO_TARGET_DIR:-}" ] && [ "$(realpath -m "$CARGO_TARGET_DIR")" != "$(realpath -m "$OWN_TARGET")" ]; then
  echo "pre-commit: CARGO_TARGET_DIR=$CARGO_TARGET_DIR is not $OWN_TARGET" >&2
  exit 1
fi
export CARGO_TARGET_DIR="$OWN_TARGET"
TARGET="$CARGO_TARGET_DIR"

WRAP=()
if [ "$(id -u)" = 0 ] && command -v setpriv >/dev/null 2>&1; then
  WRAP=(setpriv --bounding-set "-dac_override,-dac_read_search,-fowner")
fi

low() {
  "${WRAP[@]+"${WRAP[@]}"}" "$@"
}

step() {
  local name=$1
  shift
  echo "pre-commit: $name" >&2
  if ! "$@"; then
    echo "pre-commit: FAILED at step: $name" >&2
    exit 1
  fi
}

lint() {
  if [ -n "${CUSTOM_LINT:-}" ]; then "$CUSTOM_LINT" "$ROOT"; else low cargo run --offline -q -p custom_lint -- "$ROOT"; fi
}

coverage_gate_tool() {
  if [ -n "${COVERAGE_GATE:-}" ]; then "$COVERAGE_GATE" "$@"
  else low cargo run --offline -q -p coverage_gate -- "$@"; fi
}

gate() {
  local -a dirs=("${SCOPE_DIRS[@]+"${SCOPE_DIRS[@]}"}")
  coverage_gate_tool "$EXPORT" "$ROOT" "--deps-dir=$CARGO_LLVM_COV_TARGET_DIR" "${dirs[@]+"${dirs[@]}"}"
}

GATE_TMPFS="${GATE_TMPFS:-/run/ostyr-gate}"
GATE_TMPFS_FLOOR_KB="${GATE_TMPFS_FLOOR_KB:-4194304}"

tmpfs_has_room() {
  local free_kb
  [ -d "$GATE_TMPFS" ] && [ -w "$GATE_TMPFS" ] || return 1
  free_kb=$(df -Pk "$GATE_TMPFS" 2>/dev/null | awk 'NR == 2 { print $4 }')
  [ -n "$free_kb" ] && [ "$free_kb" -ge "$GATE_TMPFS_FLOOR_KB" ]
}

pick_scratch() {
  TMPFS_RUN=""
  if tmpfs_has_room; then
    TMPFS_RUN="$GATE_TMPFS/run-$$"
    if mkdir -p "$TMPFS_RUN" && chmod 0755 "$TMPFS_RUN"; then :; else TMPFS_RUN=""; fi
  fi
  if [ -n "$TMPFS_RUN" ]; then SCRATCH="$TMPFS_RUN"; else SCRATCH="$RUN_DIR/tmp"; fi
  mkdir -p "$SCRATCH"
}

covered_tests() {
  local status=0
  pick_scratch
  TMPDIR="$SCRATCH" low cargo +nightly llvm-cov --offline --branch "${PACKAGE_ARGS[@]+"${PACKAGE_ARGS[@]}"}" --fail-under-lines 100 --json --output-path "$EXPORT" || status=$?
  rm -rf "$SCRATCH"
  return "$status"
}

doc_tests() {
  local status=0
  pick_scratch
  TMPDIR="$SCRATCH" low cargo test --doc --offline "${PACKAGE_ARGS[@]+"${PACKAGE_ARGS[@]}"}" || status=$?
  rm -rf "$SCRATCH"
  return "$status"
}

cleanup_run() {
  rm -rf "$RUN_DIR"
  if [ -n "${TMPFS_RUN:-}" ]; then rm -rf "$TMPFS_RUN"; fi
  if [ -z "$(find "$GATE_DIR" -mindepth 1 -maxdepth 1 -name 'run-*' 2>/dev/null)" ]; then rm -rf "$GATE_DIR"; fi
}

prepare_gate_dir() {
  GATE_DIR="$TARGET/gates/$(printf %s "$ROOT" | cksum | cut -d' ' -f1)"
  RUN_DIR="$GATE_DIR/run-$$"
  export CARGO_LLVM_COV_TARGET_DIR="$GATE_DIR/llvm-cov-target"
  export CARGO_LLVM_COV_BUILD_DIR="$TARGET/llvm-cov-target"
  GATE_STALE_DAYS=1
  if [ -d "$TARGET/gates" ]; then find "$TARGET/gates" -mindepth 1 -maxdepth 1 -mtime "+$GATE_STALE_DAYS" -exec rm -rf {} +; fi
  if [ -d "$GATE_TMPFS" ]; then find "$GATE_TMPFS" -mindepth 1 -maxdepth 1 -name 'run-*' -mtime "+$GATE_STALE_DAYS" -exec rm -rf {} + 2>/dev/null || true; fi
  trap cleanup_run EXIT
  EXPORT="${COVERAGE_EXPORT:-$RUN_DIR/coverage.json}"
  mkdir -p "$RUN_DIR" "$(dirname "$EXPORT")"
}

MENTION_PATTERN='cl''aude|anthro''pic'

unpublished_path() {
  case "$1" in
    .cl''aude/* | backlog/* | docs/ai-development.md | .githooks/commit-msg | tests/cl''aude-hooks.sh | CL''AUDE.md | */CL''AUDE.md) return 0 ;;
    *) return 1 ;;
  esac
}

rewritten_path() {
  local filter="$ROOT/.cl""aude/publish/index-filter.sh"
  [ -f "$filter" ] && grep -q -F -- "rewrite $1 " "$filter"
}

check_published_mentions() {
  local path added found=0
  local -a paths
  mapfile -t paths < <(git diff --cached --ignore-submodules=none --name-only --diff-filter=ACMR)
  for path in "${paths[@]+"${paths[@]}"}"; do
    if ! unpublished_path "$path" && ! rewritten_path "$path"; then
      added=$(git diff --cached --ignore-submodules=none -U0 -- "$path" | grep '^+' | grep -v '^+++ ' || true)
      if grep -q -i -E -- "$MENTION_PATTERN" <<<"$added"; then
        echo "pre-commit: $path is published and an added line matches '$MENTION_PATTERN'; reword it or add a rewrite in its index-filter.sh" >&2
        found=1
      fi
    fi
  done
  return "$found"
}

if ! check_published_mentions; then exit 1; fi

PUBLISHED_REF=refs/remotes/public/main

check_published_migrations() {
  local path published found=0
  local -a paths
  if ! git rev-parse --verify -q "$PUBLISHED_REF^{commit}" >/dev/null; then
    echo "pre-commit: WARNING $PUBLISHED_REF is absent: published migrations are not checked (add the public remote and fetch it)" >&2
    return 0
  fi
  mapfile -d '' paths < <(git ls-tree -r -z --name-only "$PUBLISHED_REF" -- crates)
  if ! wait "$!"; then
    echo "pre-commit: cannot list $PUBLISHED_REF" >&2
    return 1
  fi
  for path in "${paths[@]+"${paths[@]}"}"; do
    case "$path" in
      crates/*/migrations/*.sql) ;;
      *) continue ;;
    esac
    published=$(git rev-parse "$PUBLISHED_REF:$path")
    if [ "$(git rev-parse -q --verify ":$path" || echo missing)" != "$published" ] ||
      [ "$(git hash-object -- "$path" 2>/dev/null || echo missing)" != "$published" ]; then
      echo "pre-commit: $path is a published migration and differs from $PUBLISHED_REF: a published migration is never edited; add a new one" >&2
      found=1
    fi
  done
  return "$found"
}

if ! check_published_migrations; then exit 1; fi

docs_only() {
  local staged path
  staged=$(changed --name-only --diff-filter=ACMRD)
  [ -n "$staged" ] || return 1
  while IFS= read -r path; do
    case "$path" in
      backlog/* | .cache/* | NOTES.md | */NOTES.md) ;;
      crates/* | tools/* | lab/* | docs/*) return 1 ;;
      *.md) ;;
      *) return 1 ;;
    esac
  done <<<"$staged"
}

if docs_only; then
  step "custom_lint" lint
  echo "pre-commit: documentation-only commit, Rust steps skipped" >&2
  exit 0
fi

SCOPE_JQ='
  . as $meta
  | ($meta.workspace_members) as $members
  | [$meta.packages[] | select(.id as $id | $members | index($id)) | {id, name, dir: (.manifest_path | ltrimstr($root + "/") | rtrimstr("/Cargo.toml"))}] as $pkgs
  | [$staged[] | . as $path | {path: $path, hit: ($pkgs | map(select(.dir as $dir | $path | startswith($dir + "/"))) | first)}] as $hits
  | ($hits | map(select(.hit == null)) | first) as $outside
  | if $outside != null then "FULL " + $outside.path + " is outside every package"
    else
      ($hits | map(.hit.id) | unique) as $seed
      | def grow($set): ([$meta.resolve.nodes[] | select(any(.deps[]; .pkg as $dep | $set | index($dep))) | .id | select(. as $id | $members | index($id))] + $set | unique);
        ($seed | until(. as $set | grow($set) == $set; grow(.))) as $closed
      | $pkgs[] | select(.id as $id | $closed | index($id)) | "PKG " + .name + " " + .dir
    end'

forced_full_path() {
  case "$1" in
    Cargo.toml | */Cargo.toml | Cargo.lock | rust-toolchain.toml | rustfmt.toml | clippy.toml | .githooks/* | tools/custom_lint/* | tools/coverage_gate/*) return 0 ;;
    */CL''AUDE.md | *.rs) return 1 ;;
    crates/* | tools/*) return 0 ;;
    *) return 1 ;;
  esac
}

compute_scope() {
  SCOPE_PKGS=()
  SCOPE_DIRS=()
  SCOPE_REASON=""
  local staged path line metadata
  staged=$(changed --name-only --no-renames)
  if [ "${GATE_SCOPE:-}" = full ]; then
    SCOPE_REASON="GATE_SCOPE=full"
  elif [ -z "$staged" ]; then
    SCOPE_REASON="no staged path"
  else
    while IFS= read -r path; do
      if [ -z "$SCOPE_REASON" ] && forced_full_path "$path"; then SCOPE_REASON="$path changes the whole workspace"; fi
    done <<<"$staged"
  fi
  if [ -z "$SCOPE_REASON" ]; then
    metadata=$(low cargo metadata --offline --format-version 1 2>/dev/null || true)
    if [ -z "$metadata" ]; then
      SCOPE_REASON="no cargo metadata"
    else
      while IFS= read -r line; do
        case "$line" in
          "FULL "*) SCOPE_REASON="${line#FULL }" ;;
          "PKG "*)
            SCOPE_PKGS+=("$(cut -d' ' -f2 <<<"$line")")
            SCOPE_DIRS+=("$(cut -d' ' -f3 <<<"$line")")
            ;;
        esac
      done < <(jq -r --arg root "$ROOT" --argjson staged "$(jq -R . <<<"$staged" | jq -s .)" "$SCOPE_JQ" <<<"$metadata")
      if [ -z "$SCOPE_REASON" ] && [ "${#SCOPE_PKGS[@]}" -eq 0 ]; then SCOPE_REASON="no package resolved"; fi
    fi
  fi
  if [ -n "$SCOPE_REASON" ]; then
    SCOPE_PKGS=()
    SCOPE_DIRS=()
    echo "pre-commit: scope full workspace ($SCOPE_REASON)" >&2
  else
    echo "pre-commit: scope ${GATE_BASE_SHA:+(diff $GATE_BASE_SHA) }${#SCOPE_PKGS[@]} packages: ${SCOPE_PKGS[*]}" >&2
  fi
}

package_args() {
  local name
  PACKAGE_ARGS=()
  for name in "${SCOPE_PKGS[@]+"${SCOPE_PKGS[@]}"}"; do PACKAGE_ARGS+=(-p "$name"); done
}

EBPF_NIGHTLY="${EBPF_NIGHTLY:-nightly-2026-11-08}"
EBPF_MANIFEST=crates/ebpf-probes/ebpf/Cargo.toml
EBPF_CLIPPY_DIR="$TARGET/ebpf-clippy"
EBPF_KERNEL_OBJECT="$TARGET/bpfel-unknown-none/release/ebpf-probes-kernel"
EBPF_NO_PANIC="${EBPF_NO_PANIC:-lab/ebpf-no-panic.sh}"

kernel_touched() {
  local path
  local -a staged
  if [ "${GATE_SCOPE:-}" = full ]; then return 0; fi
  mapfile -d '' staged < <(changed --name-only -z --no-renames)
  for path in "${staged[@]+"${staged[@]}"}"; do
    if forced_full_path "$path"; then return 0; fi
    case "$path" in
      crates/ebpf-probes/ebpf/* | lab/ebpf-no-panic.sh | lab/tests/ebpf-no-panic-test.sh | lab/ebpf-build.sh) return 0 ;;
    esac
  done
  return 1
}

kernel_declaration() {
  KERNEL_STATE=$(coverage_gate_tool kernel-declared "$ROOT")
}

kernel_manifest_present() {
  if [ ! -f "$EBPF_MANIFEST" ]; then
    echo "pre-commit: $EBPF_MANIFEST is missing but root Cargo.toml excludes crates/ebpf-probes/ebpf" >&2
    return 1
  fi
}

kernel_checks() {
  check_cargo_directories &&
    kernel_manifest_present &&
    low env EBPF_CHECK_ONLY=1 EBPF_OFFLINE=1 EBPF_NIGHTLY="$EBPF_NIGHTLY" lab/ebpf-build.sh "$EBPF_MANIFEST" &&
    low cargo +nightly fmt --check --manifest-path "$EBPF_MANIFEST" &&
    kernel_clippy &&
    kernel_build &&
    kernel_object_check
}

kernel_clippy() {
  local status=0
  rm -rf "$EBPF_CLIPPY_DIR"
  low cargo "+$EBPF_NIGHTLY" clippy --offline --locked --release --target bpfel-unknown-none -Z build-std=core \
    --manifest-path "$EBPF_MANIFEST" --target-dir "$EBPF_CLIPPY_DIR" -- -D warnings || status=$?
  rm -rf "$EBPF_CLIPPY_DIR"
  return "$status"
}

kernel_build() {
  rm -f "$EBPF_KERNEL_OBJECT" &&
    low env EBPF_OFFLINE=1 EBPF_NIGHTLY="$EBPF_NIGHTLY" lab/ebpf-build.sh "$EBPF_MANIFEST" "$TARGET"
}

kernel_object_check() {
  if [ ! -f "$EBPF_KERNEL_OBJECT" ]; then
    echo "pre-commit: the kernel build did not write $EBPF_KERNEL_OBJECT" >&2
    return 1
  fi
  low env EBPF_NIGHTLY="$EBPF_NIGHTLY" "$EBPF_NO_PANIC" "$EBPF_KERNEL_OBJECT"
}

kernel_stage() {
  step "kernel crate: declaration" kernel_declaration
  case "$KERNEL_STATE" in
    declared)
      if kernel_touched; then step "kernel crate: fmt and clippy for bpfel-unknown-none" kernel_checks; fi
      ;;
    absent) echo "pre-commit: kernel crate step skipped (root Cargo.toml does not exclude crates/ebpf-probes/ebpf)" >&2 ;;
    *)
      echo "pre-commit: FAILED at step: kernel crate: unexpected declaration state '$KERNEL_STATE'" >&2
      exit 1
      ;;
  esac
}

kernel_only_commit() {
  local i meta path status old_mode new_mode
  local -a entries
  if [ "${GATE_SCOPE:-}" = full ]; then return 1; fi
  mapfile -d '' entries < <(changed --raw -z --no-renames --no-abbrev)
  [ "${#entries[@]}" -gt 0 ] || return 1
  for ((i = 0; i + 1 < ${#entries[@]}; i += 2)); do
    meta="${entries[i]}"
    path="${entries[i + 1]}"
    read -r old_mode new_mode _ _ status <<<"${meta#:}"
    case "$status" in
      A | C | M | D) ;;
      *) return 1 ;;
    esac
    case "$old_mode $new_mode" in
      "100644 100644" | "100644 100755" | "100755 100644" | "100755 100755" | "000000 100644" | "000000 100755" | "100644 000000" | "100755 000000") ;;
      *) return 1 ;;
    esac
    case "$path" in
      crates/ebpf-probes/ebpf/src/*.rs) ;;
      *) return 1 ;;
    esac
  done
}

if [ "$EBPF_NO_PANIC" != lab/ebpf-no-panic.sh ]; then
  echo "pre-commit: override EBPF_NO_PANIC=$EBPF_NO_PANIC" >&2
fi

if kernel_only_commit; then
  echo "pre-commit: kernel-only commit, the workspace steps (fmt, clippy, llvm-cov, coverage_gate, doc tests) are skipped" >&2
  step "custom_lint" lint
  kernel_stage
  echo "pre-commit: all steps passed" >&2
  exit 0
fi

compute_scope
prepare_gate_dir
package_args
step "1/6 cargo +nightly fmt --check" low cargo +nightly fmt --check "${PACKAGE_ARGS[@]+"${PACKAGE_ARGS[@]}"}"
step "2/6 cargo clippy" low cargo clippy --offline "${PACKAGE_ARGS[@]+"${PACKAGE_ARGS[@]}"}" --all-targets -- -D warnings
step "3/6 custom_lint" lint
step "4/6 cargo llvm-cov" covered_tests
step "5/6 coverage_gate" gate
step "6/6 cargo test --doc" doc_tests
kernel_stage
echo "pre-commit: all steps passed" >&2
