{
  "name": "ostyr",
  "networks": {
    "default": {
      "ipam": {
        "config": [
          {
            "ip_range": "172.29.63.128/25",
            "subnet": "172.29.63.0/24"
          }
        ]
      },
      "name": "ostyr_default"
    }
  },
  "secrets": {
    "agent_ca": {
      "file": "secrets/agent_ca.crt",
      "name": "ostyr_agent_ca"
    },
    "api_tls_cert": {
      "file": "secrets/api_tls.crt",
      "name": "ostyr_api_tls_cert"
    },
    "api_tls_key": {
      "file": "secrets/api_tls.key",
      "name": "ostyr_api_tls_key"
    },
    "gateway_tls_cert": {
      "file": "secrets/gateway_tls.crt",
      "name": "ostyr_gateway_tls_cert"
    },
    "gateway_tls_key": {
      "file": "secrets/gateway_tls.key",
      "name": "ostyr_gateway_tls_key"
    },
    "nats_conf": {
      "file": "secrets/nats.conf",
      "name": "ostyr_nats_conf"
    },
    "nats_gateway_password": {
      "file": "secrets/nats_gateway_password",
      "name": "ostyr_nats_gateway_password"
    },
    "nats_server_cert": {
      "file": "secrets/nats_server.crt",
      "name": "ostyr_nats_server_cert"
    },
    "nats_server_key": {
      "file": "secrets/nats_server.key",
      "name": "ostyr_nats_server_key"
    },
    "pg_ca": {
      "file": "secrets/ca.crt",
      "name": "ostyr_pg_ca"
    },
    "pg_password": {
      "file": "secrets/pg_password",
      "name": "ostyr_pg_password"
    },
    "pg_server_cert": {
      "file": "secrets/pg_server.crt",
      "name": "ostyr_pg_server_cert"
    },
    "pg_server_key": {
      "file": "secrets/pg_server.key",
      "name": "ostyr_pg_server_key"
    },
    "pg_service_password": {
      "file": "secrets/pg_service_password",
      "name": "ostyr_pg_service_password"
    },
    "playbooks_pg_password": {
      "file": "secrets/playbooks_pg_password",
      "name": "ostyr_playbooks_pg_password"
    },
    "store_key": {
      "file": "secrets/store.key",
      "name": "ostyr_store_key"
    }
  },
  "services": {
    "gateway": {
      "cap_drop": [
        "ALL"
      ],
      "command": [
        "/usr/local/bin/ostyr-event-gateway",
        "/etc/ostyr/gateway-server.yaml",
        "/etc/ostyr/gateway.yaml"
      ],
      "depends_on": {
        "nats": {
          "condition": "service_started",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "RUST_LOG": "info"
      },
      "image": "ostyr-platform:local",
      "networks": {
        "default": {
          "ipv4_address": "172.29.63.11"
        }
      },
      "pull_policy": "never",
      "read_only": true,
      "restart": "unless-stopped",
      "secrets": [
        {
          "source": "pg_ca",
          "target": "/run/secrets/pg_ca"
        },
        {
          "source": "gateway_tls_key",
          "target": "/run/secrets/gateway_tls_key"
        },
        {
          "source": "gateway_tls_cert",
          "target": "/run/secrets/gateway_tls_cert"
        },
        {
          "source": "agent_ca",
          "target": "/run/secrets/agent_ca"
        },
        {
          "source": "nats_gateway_password",
          "target": "/run/secrets/nats_gateway_password"
        }
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "user": "65534:65534",
      "volumes": [
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "config",
          "target": "/etc/ostyr",
          "type": "bind"
        },
        {
          "source": "gatewaystate",
          "target": "/var/lib/ostyr-gateway",
          "type": "volume",
          "volume": {}
        }
      ]
    },
    "nats": {
      "cap_drop": [
        "ALL"
      ],
      "command": [
        "--config",
        "/run/secrets/nats_conf"
      ],
      "entrypoint": null,
      "image": "nats:2.15.2-scratch@sha256:965fc69c168a39f2bfd63a68361288beb0cc64ca60c8c308bf6c0eb74f463b1d",
      "networks": {
        "default": null
      },
      "read_only": true,
      "restart": "unless-stopped",
      "secrets": [
        {
          "source": "nats_conf",
          "target": "/run/secrets/nats_conf"
        },
        {
          "source": "nats_server_key",
          "target": "/run/secrets/nats_server_key"
        },
        {
          "source": "nats_server_cert",
          "target": "/run/secrets/nats_server_cert"
        }
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "volumes": [
        {
          "source": "natsdata",
          "target": "/data",
          "type": "volume",
          "volume": {}
        }
      ]
    },
    "platform": {
      "cap_drop": [
        "ALL"
      ],
      "command": [
        "/usr/local/bin/ostyr-platform",
        "/etc/ostyr/module.yaml"
      ],
      "depends_on": {
        "postgres": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": null,
      "image": "ostyr-platform:local",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "host_ip": "0.0.0.0",
          "mode": "ingress",
          "protocol": "tcp",
          "published": "8443",
          "target": 8443
        }
      ],
      "pull_policy": "never",
      "read_only": true,
      "restart": "unless-stopped",
      "secrets": [
        {
          "source": "pg_service_password",
          "target": "/run/secrets/pg_service_password"
        },
        {
          "source": "pg_ca",
          "target": "/run/secrets/pg_ca"
        },
        {
          "source": "api_tls_key",
          "target": "/run/secrets/api_tls_key"
        },
        {
          "source": "api_tls_cert",
          "target": "/run/secrets/api_tls_cert"
        },
        {
          "source": "store_key",
          "target": "/run/secrets/store_key"
        }
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "volumes": [
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "config",
          "target": "/etc/ostyr",
          "type": "bind"
        },
        {
          "source": "state",
          "target": "/var/lib/ostyr",
          "type": "volume",
          "volume": {}
        }
      ]
    },
    "playbooks": {
      "cap_drop": [
        "ALL"
      ],
      "command": [
        "/usr/local/bin/ostyr-playbooks",
        "/etc/ostyr/playbooks.yaml"
      ],
      "depends_on": {
        "platform": {
          "condition": "service_started",
          "required": true
        }
      },
      "entrypoint": null,
      "image": "ostyr-platform:local",
      "networks": {
        "default": null
      },
      "pull_policy": "never",
      "read_only": true,
      "restart": "unless-stopped",
      "secrets": [
        {
          "source": "playbooks_pg_password",
          "target": "/run/secrets/playbooks_pg_password"
        },
        {
          "source": "pg_ca",
          "target": "/run/secrets/pg_ca"
        }
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "user": "65533:65533",
      "volumes": [
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "config",
          "target": "/etc/ostyr",
          "type": "bind"
        },
        {
          "source": "playbooksstate",
          "target": "/var/lib/ostyr-playbooks",
          "type": "volume",
          "volume": {}
        }
      ]
    },
    "postgres": {
      "cap_add": [
        "CHOWN",
        "DAC_OVERRIDE",
        "FOWNER",
        "SETUID",
        "SETGID"
      ],
      "cap_drop": [
        "ALL"
      ],
      "command": [
        "postgres",
        "-c",
        "ssl=on",
        "-c",
        "ssl_cert_file=/run/pgtls/server.crt",
        "-c",
        "ssl_key_file=/run/pgtls/server.key",
        "-c",
        "hba_file=/etc/postgresql/pg_hba.conf"
      ],
      "entrypoint": [
        "/bin/bash",
        "-ec",
        "install -d -m 0700 -o postgres -g postgres /run/pgtls\ninstall -m 0600 -o postgres -g postgres /run/secrets/pg_service_password /run/pgtls/service_password\ninstall -m 0600 -o postgres -g postgres /run/secrets/pg_server_key /run/pgtls/server.key\ninstall -m 0644 -o postgres -g postgres /run/secrets/pg_server_cert /run/pgtls/server.crt\nexec docker-entrypoint.sh \"$$@\"\n",
        "postgres-entrypoint"
      ],
      "environment": {
        "POSTGRES_PASSWORD_FILE": "/run/secrets/pg_password"
      },
      "healthcheck": {
        "interval": "5s",
        "retries": 30,
        "test": [
          "CMD-SHELL",
          "pg_isready -U ostyr_service -d ostyr"
        ],
        "timeout": "5s"
      },
      "image": "postgres:16@sha256:dd2bf3ce2dc83a81674cf7f217fcfd8a5009a4b325dda5b843bfee82a06cff6f",
      "networks": {
        "default": null
      },
      "read_only": true,
      "restart": "unless-stopped",
      "secrets": [
        {
          "source": "pg_password",
          "target": "/run/secrets/pg_password"
        },
        {
          "source": "pg_service_password",
          "target": "/run/secrets/pg_service_password"
        },
        {
          "source": "pg_server_key",
          "target": "/run/secrets/pg_server_key"
        },
        {
          "source": "pg_server_cert",
          "target": "/run/secrets/pg_server_cert"
        },
        {
          "source": "pg_ca",
          "target": "/run/secrets/pg_ca"
        }
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/run/pgtls:mode=0700",
        "/run/postgresql",
        "/tmp"
      ],
      "volumes": [
        {
          "source": "pgdata",
          "target": "/var/lib/postgresql/data",
          "type": "volume",
          "volume": {}
        },
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "config/pg_hba.conf",
          "target": "/etc/postgresql/pg_hba.conf",
          "type": "bind"
        },
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "config/pg-init-service-role.sh",
          "target": "/docker-entrypoint-initdb.d/10-service-role.sh",
          "type": "bind"
        }
      ]
    },
    "relay": {
      "cap_drop": [
        "ALL"
      ],
      "command": [
        "/usr/local/bin/ostyr-relay",
        "/etc/ostyr/relay.yaml",
        "/var/lib/ostyr-relay/relay-audit.log"
      ],
      "depends_on": {
        "gateway": {
          "condition": "service_started",
          "required": true
        }
      },
      "entrypoint": null,
      "image": "ostyr-platform:local",
      "networks": {
        "default": {
          "ipv4_address": "172.29.63.12"
        }
      },
      "ports": [
        {
          "host_ip": "0.0.0.0",
          "mode": "ingress",
          "protocol": "tcp",
          "published": "7443",
          "target": 7443
        }
      ],
      "pull_policy": "never",
      "read_only": true,
      "restart": "unless-stopped",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "user": "65531:65531",
      "volumes": [
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "config",
          "target": "/etc/ostyr",
          "type": "bind"
        },
        {
          "source": "relaystate",
          "target": "/var/lib/ostyr-relay",
          "type": "volume",
          "volume": {}
        }
      ]
    },
    "web": {
      "cap_drop": [
        "ALL"
      ],
      "command": [
        "/usr/local/bin/ostyr-web-ui",
        "/etc/ostyr/web-ui.yaml"
      ],
      "depends_on": {
        "platform": {
          "condition": "service_started",
          "required": true
        }
      },
      "entrypoint": null,
      "image": "ostyr-platform:local",
      "networks": {
        "default": {
          "ipv4_address": "172.29.63.10"
        }
      },
      "ports": [
        {
          "host_ip": "0.0.0.0",
          "mode": "ingress",
          "protocol": "tcp",
          "published": "9443",
          "target": 9443
        }
      ],
      "pull_policy": "never",
      "read_only": true,
      "restart": "unless-stopped",
      "secrets": [
        {
          "source": "pg_ca",
          "target": "/run/secrets/pg_ca"
        },
        {
          "source": "api_tls_key",
          "target": "/run/secrets/api_tls_key"
        },
        {
          "source": "api_tls_cert",
          "target": "/run/secrets/api_tls_cert"
        }
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "volumes": [
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "config",
          "target": "/etc/ostyr",
          "type": "bind"
        },
        {
          "source": "webstate",
          "target": "/var/lib/ostyr",
          "type": "volume",
          "volume": {}
        }
      ]
    }
  },
  "volumes": {
    "gatewaystate": {
      "name": "ostyr_gatewaystate"
    },
    "natsdata": {
      "name": "ostyr_natsdata"
    },
    "pgdata": {
      "name": "ostyr_pgdata"
    },
    "playbooksstate": {
      "name": "ostyr_playbooksstate"
    },
    "relaystate": {
      "name": "ostyr_relaystate"
    },
    "state": {
      "name": "ostyr_state"
    },
    "webstate": {
      "name": "ostyr_webstate"
    }
  }
}
