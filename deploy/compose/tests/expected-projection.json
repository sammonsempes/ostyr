          "host_ip": "0.0.0.0",
          "mode": "ingress",
          "protocol": "tcp",
          "published": "9443",
          "target": 9443
        }
      ],
      "pull_policy": "never",
      "read_only": true,
      "restart": "unless-stopped",
      "secrets": [
